+    /// Restore Shift consumed by `normalize_shift` before forwarding a key
+    /// without its raw event (e.g. to a mux pane). Keep the composed state of
+    /// the other modifiers: composition may intentionally consume Alt/Ctrl.
+    pub fn modifiers_with_raw_shift(&self) -> Modifiers {
+        self.modifiers
+            | self
+                .raw
+                .as_ref()
+                .map(|raw| raw.modifiers & Modifiers::SHIFT)
+                .unwrap_or(Modifiers::NONE)
+    }
