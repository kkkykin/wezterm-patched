     use super::*;
 
+    #[test]
+    fn forwarding_restores_shift_after_normalization() {
+        for modifiers in [
+            Modifiers::SHIFT,
+            Modifiers::ALT | Modifiers::SHIFT,
+            Modifiers::CTRL | Modifiers::SHIFT,
+            Modifiers::CTRL | Modifiers::ALT | Modifiers::SHIFT,
+        ] {
+            let event = make_event_with_raw(
+                KeyEvent {
+                    key: KeyCode::Char('a'),
+                    modifiers,
+                    leds: KeyboardLedStatus::empty(),
+                    repeat_count: 1,
+                    key_is_down: true,
+                    raw: None,
+                    #[cfg(windows)]
+                    win32_uni_char: None,
+                },
+                None,
+            )
+            .normalize_shift();
+
+            assert_eq!(event.key, KeyCode::Char('A'));
+            assert_eq!(event.modifiers_with_raw_shift(), modifiers);
+            // Key binding lookup must still use the normalized modifiers.
+            assert_eq!(event.modifiers, modifiers - Modifiers::SHIFT);
+        }
+    }
+
+    #[test]
+    fn forwarding_preserves_composed_modifiers() {
+        let mut event = make_event_with_raw(
+            KeyEvent {
+                key: KeyCode::Char('A'),
+                modifiers: Modifiers::ALT,
+                leds: KeyboardLedStatus::CAPS_LOCK,
+                repeat_count: 1,
+                key_is_down: true,
+                raw: None,
+                #[cfg(windows)]
+                win32_uni_char: None,
+            },
+            None,
+        );
+        // An uppercase character does not by itself imply Shift.
+        assert_eq!(event.modifiers_with_raw_shift(), Modifiers::ALT);
+
+        // Do not restore Alt/Ctrl consumed by keyboard layout composition.
+        event.modifiers = Modifiers::SUPER;
+        event.raw.as_mut().unwrap().modifiers = Modifiers::CTRL | Modifiers::ALT | Modifiers::SHIFT;
+        assert_eq!(
+            event.modifiers_with_raw_shift(),
+            Modifiers::SUPER | Modifiers::SHIFT
+        );
+
+        event.raw = None;
+        assert_eq!(event.modifiers_with_raw_shift(), Modifiers::SUPER);
+        event.modifiers |= Modifiers::SHIFT;
+        assert_eq!(
+            event.modifiers_with_raw_shift(),
+            Modifiers::SUPER | Modifiers::SHIFT
+        );
+    }
