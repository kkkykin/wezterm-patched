+        // Legacy encodings fold Shift into the generated character. Kitty
+        // needs both the shifted character and the original Shift modifier,
+        // so only normalize the modifiers after the Kitty branch above.
+        let mods = match key {
+            Char(c)
+                if (c.is_ascii_punctuation() || c.is_ascii_uppercase())
+                    && mods.contains(Modifiers::SHIFT) =>
+            {
+                mods & !Modifiers::SHIFT
+            }
+            _ => mods,
+        };
